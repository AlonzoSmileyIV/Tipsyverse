{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "server.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development nodemon server.js",
    "staging": "cross-env NODE_ENV=staging nodemon server.js",
    "start": "cross-env NODE_ENV=production node server.js",
    "test": "node --test tests/**/*.test.js",
    "test:integration": "node --test tests/integration/**/*.integration.js",
    "check": "find . -name '*.js' -not -path './node_modules/*' -print0 | xargs -0 -n1 node --check",
    "wipe:collections": "NODE_ENV=development node scripts/libs/wipeAllCollections.script.js",
    "seed": "NODE_ENV=development node scripts/libs/seedInitialData.script.js",
    "seed:staging-admin": "NODE_ENV=staging node scripts/libs/seedStagingAdmin.script.js",
    "db:backup": "node scripts/libs/backupDatabase.script.js",
    "db:backup:verify": "node scripts/libs/verifyBackup.script.js",
    "db:restore-drill": "NODE_ENV=staging node scripts/libs/restoreDatabase.script.js",
    "verify:staging": "NODE_ENV=staging node scripts/libs/stagingVerify.script.js",
    "migrate:compliance": "node scripts/libs/migrateBartenderCompliance.script.js",
    "migrate:event-timezones": "node scripts/libs/migrateEventTimezones.script.js",
    "migrate:payment-requests": "node scripts/libs/migratePaymentRequestConsistency.script.js"
  },
  "author": "",
  "type": "module",
  "license": "ISC",
  "dependencies": {
    "@sentry/node": "^10.68.0",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.10.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "fs-extra": "^11.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.24.1",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pdfkit": "^0.17.2",
    "prerender-node": "^3.8.3",
    "resend": "^4.7.0",
    "socket.io": "^4.8.3",
    "stripe": "^20.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "nodemon": "^3.1.7",
    "supertest": "^7.2.2"
  }
