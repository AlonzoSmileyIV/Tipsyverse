# Runtime
NODE_ENV=production
PORT=3001
API_URL=/api/v1

# URLs
FRONTEND_URL=https://tipsyverse.com
PUBLIC_APP_URL=https://tipsyverse.com
ADMIN_PORTAL_URL=https://tipsyverse.com
PUBLIC_SHARE_URL=https://api.tipsyverse.com
CORS_ORIGINS=https://tipsyverse.com,https://www.tipsyverse.com
TRUST_PROXY=1
JOBS_ENABLED=true
APP_RELEASE=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info
ACTIVITY_LOG_RETENTION_DAYS=365
EMAIL_OUTBOX_RETENTION_DAYS=30

# MongoDB
MONGO_URI=
MONGO_DEV_URI=
MONGO_STAGING_URI=
# Set only in the hosting provider's encrypted environment. Use a dedicated
# production database that is not shared with development or staging.
MONGO_PROD_URI=
MONGO_BACKUP_URI=
# JSON overrides by state. DEFAULT applies before state-specific values.
# Example: {"DEFAULT":{"permitRequired":false},"IN":{"permitRequired":true}}
STATE_COMPLIANCE_POLICY_JSON=

# Auth
# Generate two independent production values with at least 32 random bytes.
# Never commit the generated values or reuse development/staging secrets.
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SALT_ROUNDS=10

# Email
RESEND_EMAIL_KEY=
FROM_EMAIL=Tipsyverse <hello@tipsyverse.com>
SUPPORT_EMAIL=hello@tipsyverse.com

# Cloudinary uploads are isolated automatically under production/images and
# production/videos when NODE_ENV=production.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Google Maps Platform server key (Time Zone API enabled; never expose publicly)
GOOGLE_MAPS_API_KEY=

# Payment provider
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SEO / sharing
PRERENDER_TOKEN=

# Seed admin accounts
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@tipsyverse.com
ADMIN_SEED_FULL_NAME=Admin Tipsyverse
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PERMIT_NUMBER=
ADMIN_SEED_PERMIT_EXP_DATE=2030-12-31

ADMIN2_SEED_USERNAME=alonzo.smiley
ADMIN2_SEED_EMAIL=alonzo.smiley@tipsyverse.com
ADMIN2_SEED_FULL_NAME=Alonzo Smiley
ADMIN2_SEED_PASSWORD=
ADMIN2_SEED_PERMIT_NUMBER=
ADMIN2_SEED_PERMIT_EXP_DATE=2030-12-31

# Seeded QA accounts (development and staging only)
QA_SEED_PASSWORD=

# Optional automation
AUTO_EVENT_BIDDER_EMAIL=alonzo.smiley@tipsyverse.com
ONBOARDING_DOCUMENTS_DIR=

# Dangerous scripts require explicit confirmation
CONFIRM_CLEAR=false
CONFIRM_WIPE=false
CLEAN_LEGACY_ARRAYS=false
DATABASE_BACKUP_DIR=
DATABASE_RESTORE_SOURCE=
CONFIRM_RESTORE=false
