# Runtime
NODE_ENV=development
PORT=3001
API_URL=/api/v1

# URLs
FRONTEND_URL=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000
ADMIN_PORTAL_URL=http://localhost:3000
PUBLIC_SHARE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000
TRUST_PROXY=
JOBS_ENABLED=true
APP_RELEASE=
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info
ACTIVITY_LOG_RETENTION_DAYS=365
EMAIL_OUTBOX_RETENTION_DAYS=30

# MongoDB
MONGO_URI=
MONGO_DEV_URI=
MONGO_STAGING_URI=
MONGO_PROD_URI=
MONGO_BACKUP_URI=

# Auth
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
SALT_ROUNDS=10

# Email
RESEND_EMAIL_KEY=
FROM_EMAIL=Tipsyverse <admin@tipsyverse.com>
SUPPORT_EMAIL=admin@tipsyverse.com

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Payment provider
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SEO / sharing
PRERENDER_TOKEN=

# Seed admin accounts
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@tipsyverse.com
ADMIN_SEED_FULL_NAME=Admin Tipsyverse
ADMIN_SEED_PASSWORD=
ADMIN_SEED_PERMIT_NUMBER=
ADMIN_SEED_PERMIT_EXP_DATE=2030-12-31

ADMIN2_SEED_USERNAME=alonzo.smiley
ADMIN2_SEED_EMAIL=alonzo.smiley@tipsyverse.com
ADMIN2_SEED_FULL_NAME=Alonzo Smiley
ADMIN2_SEED_PASSWORD=
ADMIN2_SEED_PERMIT_NUMBER=
ADMIN2_SEED_PERMIT_EXP_DATE=2030-12-31

# Optional automation
AUTO_EVENT_BIDDER_EMAIL=alonzo.smiley@tipsyverse.com
ONBOARDING_DOCUMENTS_DIR=

# Dangerous scripts require explicit confirmation
CONFIRM_CLEAR=false
CONFIRM_WIPE=false
CLEAN_LEGACY_ARRAYS=false
DATABASE_BACKUP_DIR=
DATABASE_RESTORE_SOURCE=
CONFIRM_RESTORE=false
